<?xml version="1.0" encoding="utf-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.sourjelly.springexample.database.repository.UsedGoodsRepository">

    <select id="selectUsedGoodsList"
    resultType="com.sourjelly.springexample.database.domain.UsedGoods">
        SELECT
         `id`
        , `seller_id`
        , `title`
        , `price`
        , `description`
        , `image`
        , `created_at`
        , `updated_at`
        FROM `used_goods`
    </select>

</mapper>


